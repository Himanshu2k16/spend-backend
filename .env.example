# Server
PORT=4000
NODE_ENV=development

# PostgreSQL connection.
# LOCAL DEV (SQLite until you set up Postgres):
#   provider = "sqlite" in prisma/schema.prisma +  DATABASE_URL="file:./dev.db"
# HOSTING (Neon free Postgres — recommended; Render's free Postgres expires in 30 days):
#   provider = "postgresql" in prisma/schema.prisma +
#   DATABASE_URL="postgresql://user:pass@ep-xxx.neon.tech/spend?sslmode=require"
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# Secret used to sign session tokens — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-with-a-long-random-string"

# Frontend origin allowed to call this API (CORS) — your deployed frontend URL in production
CLIENT_ORIGIN="http://localhost:4321"

# lax for same-site (local dev); "none" when frontend and API are on different domains
COOKIE_SAMESITE=lax
